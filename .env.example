# TEMPLATE ONLY. Existing private root config.php DB constants continue working.
# Shared hosting: set constants in the private root config.php or use hosting environment settings.
# No dotenv dependency: this file is not loaded automatically.
MAAKIT_DB_HOST=localhost
MAAKIT_DB_PORT=3306
MAAKIT_DB_NAME=your_database
MAAKIT_DB_USER=your_runtime_user
MAAKIT_DB_PASS=replace_on_host_only
MAAKIT_SITE_URL=https://maakit.in
MAAKIT_JWT_ISSUER=https://maakit.in
MAAKIT_JWT_AUDIENCE=maakit-web
MAAKIT_SESSION_BRIDGE=1
# Default: private folder beside public_html, auto-generated RSA secret signing key, never overwritten.
# Optionally choose an EXISTING parent folder outside public_html:
# MAAKIT_PRIVATE_DIR=/home/your_account/maakit-private
# Optional existing RS256 key pair instead of auto-provisioning. No weak HS256 shared-secret downgrade.
# MAAKIT_JWT_KEY_FILE=/home/your_account/maakit-private/public-keys.json
# MAAKIT_JWT_PRIVATE_KEY_FILE=/home/your_account/maakit-private/private.pem
MAAKIT_JWT_KID=maakit-php-v1
# Optional real provider bridge configuration, outside public_html:
# MAAKIT_CARRIER_CONFIG=/home/your_account/maakit-private/carriers.json
