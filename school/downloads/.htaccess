AddType application/vnd.android.package-archive .apk
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header always set X-Content-Type-Options "nosniff"
  </FilesMatch>
  <Files "snmsis-teacher.apk">
    Header always set Content-Disposition "attachment; filename=snmsis-teacher.apk"
  </Files>
  <Files "snmsis-salary.apk">
    Header always set Content-Disposition "attachment; filename=snmsis-salary.apk"
  </Files>
</IfModule>
