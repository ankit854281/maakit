# Yahan sirf delivery ki tasveerein rehti hain.
# Koi PHP yahan se kabhi na chale — agar kisi ne tasveer ke
# bhes me .php chadha diya, to wo chalna nahi chahiye.
<FilesMatch "\.(php|phtml|php\d|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>  php_flag engine off </IfModule>
<IfModule mod_php8.c> php_flag engine off </IfModule>
Options -Indexes -ExecCGI
